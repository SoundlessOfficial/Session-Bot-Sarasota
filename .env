# ---------- Session Startup message ----------
# Name of your ER:LC server shown under "Server Information" (leave blank to hide)
SERVER_NAME=Sarasota Roleplay

# Optional: channel ID of your guidelines channel (shown as a clickable #channel)
GUIDELINES_CHANNEL_ID=1561215256867377344

# Optional: text for the "Requirements" section. Use \n for a new line. Leave blank to hide.
SESSION_REQUIREMENTS=In order to play on our server you **must** play with a Roblox account that is at least **1** month old.\nYour tier level within ER:LC must also be at least **Tier 1**

# Optional: server code pre-filled when you press Session Start
SERVER_CODE=NAVYSEAL

# Optional: link used by the "Join Server" button. {code} is replaced by the server code.
JOIN_URL=https://policeroleplay.community/join?code={NAVYSEAL}

# Optional: set to true to register the command in ALL servers the bot is in
REGISTER_GLOBAL=false
